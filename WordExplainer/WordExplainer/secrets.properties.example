# ==============================================================================
# FLEENCH API SECRETS CONFIGURATION (EXAMPLE TEMPLATE)
# ==============================================================================
# Copy this file to 'secrets.properties' and fill in your keys.
# ==============================================================================

# GROQ API KEY (Get from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# GEMINI API KEYS (Comma-separated pool from https://aistudio.google.com)
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2
